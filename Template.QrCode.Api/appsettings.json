{
  "TimoutInSeconds": "2",
  "TokenExpirationInMin": "5",
  "CryptCertificatePublic": "FRMFQrPublicKey.crt",
  "HashCertificatePrivate": "FRMF-QR-SIGN-preprod.pfx",
  "HashCertificatePrivatePassword": "",
  "HashCertificateThumbprint": "65a7a401d41dd676001ba4c18850316900e02eee",
  "HashCertificateSubjectName": "FRMF-QR-SIGN-PreProdE",
  "FromBackoffice": true,
  "ConnectionStrings": {
    "DefaultConnectionString": ""
  },
  "SwaggerOptions": {
    "JsonRoute": "swagger/{documentName}/swagger.json",
    "Description": "Template QR Code API",
    "UIEndpoint": "v1/swagger.json"
  },
  "jwt": {
    "secretKey": "",
    "expiryMinutes": "1",
    "issuer": "http://localhost:19417/api/",
    "RefreshTokenExpiryDays": "10"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Error",
      "Override": {
        "Microsoft": "Error",
        "System": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/requests-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true
        }
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "*"
    ],
    "AllowCredentials": true,
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "OPTIONS"
    ],
    "AllowedHeaders": [
      "Content-Type",
      "Authorization",
      "Accept-Language",
      "X-API-KEY"
    ],
    "ExposedHeaders": [
      "X-Rate-Limit-Remaining",
      "X-Rate-Limit-Reset"
    ]
  },
  "AllowedHosts": "*",
  "AllowedApiKeys": "",
  "EnableSwagger": true
}
